# Copy to .env and adjust. Every value below is also the built-in default for
# the local docker-compose stack, so this file is documentation more than setup.

# --- source API ---
ORDERFLOW_API_BASE=https://dummyjson.com
ORDERFLOW_PAGE_SIZE=30
ORDERFLOW_HTTP_TIMEOUT=10
ORDERFLOW_HTTP_RETRIES=4

# --- warehouse ---
ORDERFLOW_DATABASE_URL=postgresql+psycopg2://orderflow:orderflow@localhost:55432/orderflow

# --- raw snapshot archive ---
ORDERFLOW_S3_BUCKET=orderflow-raw
# Point at MinIO for local runs. Unset (or blank) talks to real AWS S3, in which
# case the bucket must already exist.
ORDERFLOW_S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
